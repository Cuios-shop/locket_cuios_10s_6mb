#!name=Locket Gold & 60s + Widget thử nghiệm - v2.1.0
#!desc=v2.1.0: cấu hình thử nghiệm 60s, video thư viện, âm thanh và 20 ghi chú + khung Gold thử nghiệm; chỉ bật module này hoặc bản thường.
#!author=Cuongqtx11
#!moduleUrl=https://raw.githubusercontent.com/Cuongqtx11/locket30s-fixed/main/locket60s-widget.sgmodule

[Script]
locket60_cache = type=http-request, pattern=^https://(?:api\.revenuecat\.com/v1/(?:receipts|subscribers/[^/?#]+)/?(?:\?[^#]*)?$|firebaseremoteconfig\.googleapis\.com/v1/projects/locket-4252a/namespaces/firebase:fetch(?:\?[^#]*)?$), script-path=https://raw.githubusercontent.com/Cuongqtx11/locket30s-fixed/main/scripts/locket.js?v=2.1.0, timeout=10
locket60_gold = type=http-response, pattern=^https://api\.revenuecat\.com/v1/(?:receipts|subscribers/[^/?#]+)/?(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Cuongqtx11/locket30s-fixed/main/scripts/locket.js?v=2.1.0, requires-body=true, max-size=1048576, timeout=10
locket60_config = type=http-response, pattern=^https://firebaseremoteconfig\.googleapis\.com/v1/projects/locket-4252a/namespaces/firebase:fetch(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Cuongqtx11/locket30s-fixed/main/scripts/locket.js?v=2.1.0, argument=gold-frame, requires-body=true, max-size=1048576, timeout=10

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
