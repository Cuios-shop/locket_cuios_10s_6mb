#!desc=Mục tiêu: quay 60s, nhập 10s/6 MiB, mic và 54 ghi chú nền gradient. Chưa xác nhận trên iPhone; chỉ bật một module Locket.
#!author=Cuios.shop
#!moduleUrl=https://raw.githubusercontent.com/Cuios-shop/locket_cuios_10s_6mb/main/locket60s_10s_6mb.sgmodule

[Script]
cuios4_status = type=http-request, pattern=^http://cuios-status\.invalid/(?:status|report\.json)(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Cuios-shop/locket_cuios_10s_6mb/main/scripts/releases/locket-v4.1.1-9492ace4527d.js, timeout=10, enable=true
cuios4_https = type=http-request, pattern=^https://(?:api\.revenuecat\.com|firebaseremoteconfig\.googleapis\.com)/cuios-check(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Cuios-shop/locket_cuios_10s_6mb/main/scripts/releases/locket-v4.1.1-9492ace4527d.js, timeout=10, enable=true
cuios4_request = type=http-request, pattern=^https://(?:(?:api\.revenuecat\.com|api\.rc-backup\.com|api-production\.8-lives-cat\.io)/(?:v1|v2)/(?:receipts|subscribers)(?:[/?]|$)|firebaseremoteconfig\.googleapis\.com/v1/projects/[^/?#]+/namespaces/[^/?#]+:fetch/?(?:\?[^#]*)?$), script-path=https://raw.githubusercontent.com/Cuios-shop/locket_cuios_10s_6mb/main/scripts/releases/locket-v4.1.1-9492ace4527d.js, timeout=10, enable=true
cuios4_revenuecat = type=http-response, pattern=^https://(?:api\.revenuecat\.com|api\.rc-backup\.com|api-production\.8-lives-cat\.io)/(?:v1|v2)/(?:receipts|subscribers)(?:[/?]|$), script-path=https://raw.githubusercontent.com/Cuios-shop/locket_cuios_10s_6mb/main/scripts/releases/locket-v4.1.1-9492ace4527d.js, requires-body=true, max-size=1048576, timeout=10, enable=true
cuios4_firebase = type=http-response, pattern=^https://firebaseremoteconfig\.googleapis\.com/v1/projects/(?:locket-4252a|869942740286)/namespaces/firebase:fetch/?(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Cuios-shop/locket_cuios_10s_6mb/main/scripts/releases/locket-v4.1.1-9492ace4527d.js, requires-body=true, max-size=1048576, timeout=10, enable=true

[Host]
cuios-status.invalid = 198.18.0.1

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, api-production.8-lives-cat.io, firebaseremoteconfig.googleapis.com
