#!name=Locket Gold & 30s - Fixed
#!desc=Bản thử nghiệm: sửa routing Gold/Remote Config và cache; xem README để cài và đọc giới hạn.
#!author=Cuongqtx11
#!moduleUrl=https://raw.githubusercontent.com/Cuongqtx11/locket30s-fixed/main/locket30s.sgmodule

[Script]
locket_cache = type=http-request, pattern=^https://(?:api\.revenuecat\.com/v1/(?:receipts|subscribers/[^/?#]+)/?(?:\?[^#]*)?$|firebaseremoteconfig\.googleapis\.com/v1/projects/locket-4252a/namespaces/firebase:fetch(?:\?[^#]*)?$), script-path=https://raw.githubusercontent.com/Cuongqtx11/locket30s-fixed/main/scripts/locket.js, timeout=10
locket_gold = type=http-response, pattern=^https://api\.revenuecat\.com/v1/(?:receipts|subscribers/[^/?#]+)/?(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Cuongqtx11/locket30s-fixed/main/scripts/locket.js, requires-body=true, max-size=1048576, timeout=10
locket_config = type=http-response, pattern=^https://firebaseremoteconfig\.googleapis\.com/v1/projects/locket-4252a/namespaces/firebase:fetch(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Cuongqtx11/locket30s-fixed/main/scripts/locket.js, requires-body=true, max-size=1048576, timeout=10

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
