#!name=Cuios • Locket 60s / 100 MB • aura-frame • Refresh r1 • v3.0.0
#!desc=Mic & âm thanh kế thừa bản ổn định; cấu hình nhập 60s/100 MB, 4 ghi chú Cuios + 50 mẫu mới. Chỉ bật một module Locket.
#!author=Cuongqtx11 / Cuios
#!moduleUrl=https://raw.githubusercontent.com/Cuongqtx11/locket60s_amthanh_mic/main/locket60s-refresh.sgmodule

[Script]
cuios_refresh_cache = type=http-request, pattern=^https://(?:api\.revenuecat\.com/v1/(?:receipts|subscribers/[^/?#]+)/?(?:\?[^#]*)?$|firebaseremoteconfig\.googleapis\.com/v1/projects/locket-4252a/namespaces/firebase:fetch(?:\?[^#]*)?$), script-path=https://raw.githubusercontent.com/Cuongqtx11/locket60s_amthanh_mic/9bb85e7170fab5ffd8160889c934ddb2cc5ec51b/scripts/locket.js, timeout=10
cuios_refresh_gold = type=http-response, pattern=^https://api\.revenuecat\.com/v1/(?:receipts|subscribers/[^/?#]+)/?(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Cuongqtx11/locket60s_amthanh_mic/9bb85e7170fab5ffd8160889c934ddb2cc5ec51b/scripts/locket.js, requires-body=true, max-size=1048576, timeout=10
cuios_refresh_config = type=http-response, pattern=^https://firebaseremoteconfig\.googleapis\.com/v1/projects/locket-4252a/namespaces/firebase:fetch(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Cuongqtx11/locket60s_amthanh_mic/9bb85e7170fab5ffd8160889c934ddb2cc5ec51b/scripts/locket.js, argument=aura-frame, requires-body=true, max-size=1048576, timeout=10

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
